# ── Clés API ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Clé Anthropic (requise si LLM_MODEL est un modèle Claude)
ANTHROPIC_API_KEY=
# Google Gemini (LLM + embeddings)
GEMINI_API_KEY=

# ── LLM de génération ─────────────────────────────────────────────────────────
# Modèle de génération (LiteLLM — préfixe provider obligatoire pour Ollama)
LLM_MODEL=gpt-4.1-mini
# Alternatives OpenAI  : gpt-4.1, gpt-4.1-nano
# Alternatives Claude  : claude-sonnet-4-6, claude-haiku-4-5
# Alternatives Ollama  : ollama/gemma4:e2b, ollama/llama3.2
LLM_TIMEOUT=30
# Augmenter pour Ollama (CPU) : 120+

# Ollama — endpoint (uniquement si LLM_MODEL ou EMBEDDING_MODEL commence par ollama/)
# LiteLLM route automatiquement OpenAI/Anthropic vers leurs endpoints officiels
OLLAMA_API_BASE=http://host.docker.internal:11434
# OLLAMA_THINK=false  # Désactive le mode thinking (Gemma4, etc.) — réduit la latence

# ── Embedding ─────────────────────────────────────────────────────────────────
# IMPORTANT : doit correspondre au modèle utilisé lors de l'ingestion.
# Changer ce modèle APRÈS une ingestion nécessite de réindexer tous les documents
# (dimensions vectorielles incompatibles dans Weaviate).
EMBEDDING_MODEL=text-embedding-3-large
# Alternatives OpenAI : text-embedding-3-small (1536 dims)
# Alternatives Ollama : ollama/nomic-embed-text-v2-moe:latest (768 dims)
EMBEDDING_TIMEOUT=60
# Augmenter pour Ollama (CPU, cold start) : 300+

# ── Ingestion documents ───────────────────────────────────────────────────────
# Parser PDF/Office par défaut : mineru | docling | simple
# - mineru   : qualité maximale (requiert CPU avec AVX/x86-v2)
# - docling  : alternative légère (peut avoir des problèmes mémoire)
# - simple   : fallback multimodal PyMuPDF+markitdown (universel, tous CPU)
INGEST_DEFAULT_PARSER=mineru

# Vision refinery : analyse des images embarquées dans les documents
USE_INGEST_VISION_REFINERY=false
# Modèle vision (doit supporter les images — GPT-4o, claude-sonnet-4-6, etc.)
INGEST_REFINERY_MODEL=gpt-4.1-mini
INGEST_REFINERY_TIMEOUT=120
# Niveau de détail vision : low | high | auto
INGEST_VISION_DETAIL=low

# RAG contextuel : enrichit chaque chunk avec un résumé du document
USE_INGEST_CONTEXTUAL_RAG=false

# ── Weaviate (vector store) ───────────────────────────────────────────────────
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080

# ── Paramètres RAG ────────────────────────────────────────────────────────────
# Nombre de chunks transmis au LLM pour la génération
TOP_K_FINAL=10
# Pondération hybride : 0.0 = BM25 pur, 1.0 = dense pur, 0.5 = équilibré
HYBRID_ALPHA=0.5
# Tokens max dans la réponse générée
MAX_TOKENS=1000
# Itérations max de la boucle ReAct
MAX_AGENT_ITER=10

# ── API FastAPI ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Authentification JWT ───────────────────────────────────────────────────────
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-generate-a-strong-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Compte admin créé automatiquement au premier démarrage
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Origines CORS (séparées par virgules, * = toutes — restreindre en production)
CORS_ORIGINS=*

# ── Base de données ────────────────────────────────────────────────────────────
# SQLite (dev/tests) — créé automatiquement
DATABASE_URL=sqlite+aiosqlite:///./rag.db
# PostgreSQL (production) :
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ragdb
DB_ECHO=false

# ── Object Storage MinIO / S3 ─────────────────────────────────────────────────
# Laisser vide pour stockage local (./uploads/)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRES=3600

# ── Celery / Redis (ingestion asynchrone) ─────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_INGEST_CONCURRENCY=2
CELERY_WORKER_LIGHT_CONCURRENCY=4
CELERY_INGEST_SOFT_TIMEOUT=1800

# ── Reranking Cohere (optionnel) ───────────────────────────────────────────────
# COHERE_API_KEY=

# ── Audit RAG (fichiers JSON par requête) ─────────────────────────────────────
# Répertoire de sortie des audits (créé automatiquement)
# RAG_AUDIT_DIR=audits
